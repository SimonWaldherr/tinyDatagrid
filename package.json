{
  "name": "tiny-datagrid",
  "description": "A dependency-free browser data grid with spreadsheet formulas, pivots, and a SQL client adapter",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "./src/tinygrid.js",
  "module": "./src/tinygrid.js",
  "types": "./src/tinygrid.d.ts",
  "exports": {
    ".": {
      "types": "./src/tinygrid.d.ts",
      "import": "./src/tinygrid.js"
    },
    "./sql-client": {
      "types": "./src/sql-client.d.ts",
      "import": "./src/sql-client.js"
    },
    "./style.css": {
      "types": "./src/style.d.ts",
      "default": "./src/tinygrid.css"
    },
    "./themes.css": {
      "types": "./src/style.d.ts",
      "default": "./src/themes.css"
    },
    "./json-tools.css": {
      "types": "./src/style.d.ts",
      "default": "./src/json-tools.css"
    },
    "./search-tools.css": {
      "types": "./src/style.d.ts",
      "default": "./src/search-tools.css"
    },
    "./charts.css": {
      "types": "./src/style.d.ts",
      "default": "./src/charts.css"
    },
    "./formula-assist.css": {
      "types": "./src/style.d.ts",
      "default": "./src/formula-assist.css"
    },
    "./exporters": {
      "types": "./src/exporters.d.ts",
      "import": "./src/exporters.js"
    },
    "./charts": {
      "types": "./src/charts.d.ts",
      "import": "./src/charts.js"
    },
    "./search-tools": {
      "types": "./src/search-tools.d.ts",
      "import": "./src/search-tools.js"
    },
    "./data-tools": {
      "types": "./src/data-tools.d.ts",
      "import": "./src/data-tools.js"
    },
    "./rule-tools": {
      "types": "./src/rule-tools.d.ts",
      "import": "./src/rule-tools.js"
    },
    "./list-dropdown": {
      "types": "./src/list-dropdown.d.ts",
      "import": "./src/list-dropdown.js"
    },
    "./formula-assist": {
      "types": "./src/formula-assist.d.ts",
      "import": "./src/formula-assist.js"
    },
    "./feature-i18n": {
      "types": "./src/feature-i18n.d.ts",
      "import": "./src/feature-i18n.js"
    },
    "./json-tools": {
      "types": "./src/json-tools.d.ts",
      "import": "./src/json-tools.js"
    },
    "./json": {
      "types": "./src/json-values.d.ts",
      "import": "./src/json-values.js"
    },
    "./features": {
      "types": "./src/features.d.ts",
      "import": "./src/features.js"
    },
    "./worksheets": {
      "types": "./src/worksheets.d.ts",
      "import": "./src/worksheets.js"
    },
    "./indexeddb": {
      "types": "./src/indexeddb.d.ts",
      "import": "./src/indexeddb.js"
    },
    "./pivots": {
      "types": "./src/pivots.d.ts",
      "import": "./src/pivots.js"
    },
    "./function-help": {
      "types": "./src/function-help.d.ts",
      "import": "./src/function-help.js"
    },
    "./cell-context-menu": {
      "types": "./src/cell-context-menu.d.ts",
      "import": "./src/cell-context-menu.js"
    },
    "./worksheet-tabs": {
      "types": "./src/worksheet-tabs.d.ts",
      "import": "./src/worksheet-tabs.js"
    },
    "./analysis": {
      "types": "./src/analysis.d.ts",
      "import": "./src/analysis.js"
    },
    "./heatmap": {
      "types": "./src/heatmap.d.ts",
      "import": "./src/heatmap.js"
    },
    "./simulations": {
      "types": "./src/simulations.d.ts",
      "import": "./src/simulations.js"
    },
    "./formula-catalog": {
      "types": "./src/formula-catalog.d.ts",
      "import": "./src/formula-catalog.js"
    },
    "./values": {
      "types": "./src/values.d.ts",
      "import": "./src/values.js"
    },
    "./form-generator": {
      "types": "./src/form-generator.d.ts",
      "import": "./src/form-generator.js"
    },
    "./form-ui": {
      "types": "./src/form-ui.d.ts",
      "import": "./src/form-ui.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "node test/test-form-generator.mjs && node test/test-excel-safety.mjs && node test/test-formula-catalog.mjs && node scripts/formula-overview.mjs --check && node test/test.mjs && node test/test-functions.mjs && node test/test-calendar-colors.mjs && node test/test-data-types.mjs && node test/test-json.mjs && node test/test-arrays.mjs && node test/test-find.mjs && node test/test-editor-layout.mjs && node test/test-sheet-growth.mjs && node test/test-worksheets.mjs && node test/test-data-tools.mjs && node test/test-pivots.mjs && node test/test-rules.mjs",
    "benchmark": "node benchmarks/recalculation.mjs",
    "benchmark:large": "node --max-old-space-size=2048 benchmarks/large-grid.mjs",
    "docs:formulas": "node scripts/formula-overview.mjs"
  }
}
