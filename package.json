{
  "name": "tiny-datagrid",
  "description": "A dependency-free browser spreadsheet and data grid with formulas, worksheets, pivots, charts, forms and local SQL",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "./src/tinygrid.js",
  "module": "./src/tinygrid.js",
  "types": "./src/tinygrid.d.ts",
  "exports": {
    "./local-sql": {
      "types": "./src/local-sql.d.ts",
      "import": "./src/local-sql.js"
    },
    "./bi": {
      "types": "./src/bi.d.ts",
      "import": "./src/bi.js"
    },
    ".": {
      "types": "./src/tinygrid.d.ts",
      "import": "./src/tinygrid.js"
    },
    "./sql-client": {
      "types": "./src/sql-client.d.ts",
      "import": "./src/sql-client.js"
    },
    "./style.css": {
      "types": "./src/style.d.ts",
      "default": "./src/tinygrid.css"
    },
    "./themes.css": {
      "types": "./src/style.d.ts",
      "default": "./src/themes.css"
    },
    "./json-tools.css": {
      "types": "./src/style.d.ts",
      "default": "./src/json-tools.css"
    },
    "./search-tools.css": {
      "types": "./src/style.d.ts",
      "default": "./src/search-tools.css"
    },
    "./charts.css": {
      "types": "./src/style.d.ts",
      "default": "./src/charts.css"
    },
    "./formula-assist.css": {
      "types": "./src/style.d.ts",
      "default": "./src/formula-assist.css"
    },
    "./exporters": {
      "types": "./src/exporters.d.ts",
      "import": "./src/exporters.js"
    },
    "./charts": {
      "types": "./src/charts.d.ts",
      "import": "./src/charts.js"
    },
    "./search-tools": {
      "types": "./src/search-tools.d.ts",
      "import": "./src/search-tools.js"
    },
    "./data-tools": {
      "types": "./src/data-tools.d.ts",
      "import": "./src/data-tools.js"
    },
    "./rule-tools": {
      "types": "./src/rule-tools.d.ts",
      "import": "./src/rule-tools.js"
    },
    "./list-dropdown": {
      "types": "./src/list-dropdown.d.ts",
      "import": "./src/list-dropdown.js"
    },
    "./formula-assist": {
      "types": "./src/formula-assist.d.ts",
      "import": "./src/formula-assist.js"
    },
    "./feature-i18n": {
      "types": "./src/feature-i18n.d.ts",
      "import": "./src/feature-i18n.js"
    },
    "./json-tools": {
      "types": "./src/json-tools.d.ts",
      "import": "./src/json-tools.js"
    },
    "./json": {
      "types": "./src/json-values.d.ts",
      "import": "./src/json-values.js"
    },
    "./features": {
      "types": "./src/features.d.ts",
      "import": "./src/features.js"
    },
    "./worksheets": {
      "types": "./src/worksheets.d.ts",
      "import": "./src/worksheets.js"
    },
    "./indexeddb": {
      "types": "./src/indexeddb.d.ts",
      "import": "./src/indexeddb.js"
    },
    "./pivots": {
      "types": "./src/pivots.d.ts",
      "import": "./src/pivots.js"
    },
    "./function-help": {
      "types": "./src/function-help.d.ts",
      "import": "./src/function-help.js"
    },
    "./cell-context-menu": {
      "types": "./src/cell-context-menu.d.ts",
      "import": "./src/cell-context-menu.js"
    },
    "./worksheet-tabs": {
      "types": "./src/worksheet-tabs.d.ts",
      "import": "./src/worksheet-tabs.js"
    },
    "./analysis": {
      "types": "./src/analysis.d.ts",
      "import": "./src/analysis.js"
    },
    "./heatmap": {
      "types": "./src/heatmap.d.ts",
      "import": "./src/heatmap.js"
    },
    "./simulations": {
      "types": "./src/simulations.d.ts",
      "import": "./src/simulations.js"
    },
    "./formula-catalog": {
      "types": "./src/formula-catalog.d.ts",
      "import": "./src/formula-catalog.js"
    },
    "./values": {
      "types": "./src/values.d.ts",
      "import": "./src/values.js"
    },
    "./form-generator": {
      "types": "./src/form-generator.d.ts",
      "import": "./src/form-generator.js"
    },
    "./form-ui": {
      "types": "./src/form-ui.d.ts",
      "import": "./src/form-ui.js"
    },
    "./sql-tools": {
      "types": "./src/sql-tools.d.ts",
      "import": "./src/sql-tools.js"
    },
    "./analysis-tools": {
      "types": "./src/analysis-tools.d.ts",
      "import": "./src/analysis-tools.js"
    },
    "./simulation-tools": {
      "types": "./src/simulation-tools.d.ts",
      "import": "./src/simulation-tools.js"
    },
    "./object-browser": {
      "types": "./src/object-browser.d.ts",
      "import": "./src/object-browser.js"
    },
    "./autosave": {
      "types": "./src/autosave.d.ts",
      "import": "./src/autosave.js"
    },
    "./sheet-growth": {
      "types": "./src/sheet-growth.d.ts",
      "import": "./src/sheet-growth.js"
    },
    "./sample-workbooks": {
      "types": "./src/sample-workbooks.d.ts",
      "import": "./src/sample-workbooks.js"
    },
    "./demo-i18n": {
      "types": "./src/demo-i18n.d.ts",
      "import": "./src/demo-i18n.js"
    },
    "./data-types": {
      "types": "./src/data-types.d.ts",
      "import": "./src/data-types.js"
    },
    "./demo-tools": {
      "types": "./src/demo-tools.d.ts",
      "import": "./src/demo-tools.js"
    },
    "./demo-tools.css": {
      "types": "./src/style.d.ts",
      "default": "./src/demo-tools.css"
    }
  },
  "files": [
    "src",
    "demo",
    "README.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "benchmark": "node benchmarks/recalculation.mjs",
    "benchmark:large": "node --max-old-space-size=2048 benchmarks/large-grid.mjs",
    "benchmark:sql": "node benchmarks/local-sql.mjs",
    "docs:formulas": "node scripts/formula-overview.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "node scripts/check.mjs && npm test && npm run test:types",
    "release:check": "npm run check && npm run test:package",
    "release:pack": "npm run release:check && node scripts/pack.mjs",
    "prepublishOnly": "npm run release:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonWaldherr/tinyDatagrid.git"
  },
  "homepage": "https://github.com/SimonWaldherr/tinyDatagrid#readme",
  "bugs": {
    "url": "https://github.com/SimonWaldherr/tinyDatagrid/issues"
  },
  "keywords": [
    "spreadsheet",
    "data-grid",
    "datagrid",
    "sql",
    "pivot",
    "charts",
    "vanilla-js",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "linkedom": "0.18.13",
    "typescript": "7.0.2"
  }
}
